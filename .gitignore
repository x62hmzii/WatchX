#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/fuchsia/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android specific
/android/app/src/main/java/io/flutter/plugins/
/android/app/src/main/kotlin/io/flutter/plugins/
/android/key.properties
/android/key.jks

# iOS specific
/ios/Flutter/flutter_export_environment.sh
/ios/Runner/GeneratedPluginRegistrant.*

# Windows specific
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugins.c

# Linux specific
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugins.c

# macOS specific
/macos/Flutter/GeneratedPluginRegistrant.swift

# Web specific
/web/

# Environment variables
.env
.env.local
.env.production

# Firebase configuration (if any)
/google-services.json
/GoogleService-Info.plist

# API keys and sensitive data
*_keys.dart
*_secrets.dart
*_config.dart

# Log files
*.log

# Temporary files
*.tmp
*.temp

# Package lock files (for Flutter, we use pubspec.lock but it should be committed)
# !pubspec.lock  # This should be committed for Flutter projects

# Personal IDE settings
.vscode/settings.json
.idea/workspace.xml
.idea/tasks.xml